{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DashboardLearningEvent",
  "description": "The learning event (bahuvani-progress-service, AGB-1067 section 6): one append-only record of what a student or a parent did. `LearningEvent` is a union discriminated by `kind`; each kind has its own `detail` shape.",
  "definitions": {
    "EventKind": {
      "title": "EventKind",
      "type": "string",
      "enum": [
        "read",
        "listen",
        "revisit",
        "answer",
        "reveal",
        "self-check",
        "teach-back",
        "revision",
        "round-start",
        "round-complete",
        "note",
        "buddy-question",
        "switch",
        "help-request",
        "review-done",
        "correction"
      ]
    },
    "ReviewItemType": {
      "title": "ReviewItemType",
      "type": "string",
      "enum": [
        "help-request",
        "teach-back-request",
        "question-note",
        "new-weak-spot",
        "round-finished",
        "weekly-plan-check",
        "new-notes"
      ]
    },
    "LadderStep": {
      "title": "LadderStep",
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "description": "1 Met, 2 Tried, 3 Gets it, 4 Can explain, 5 Remembers, 6 Can use it (labels: LADDER_LABELS in dashboard/index.js)."
    },
    "LadderLabel": {
      "title": "LadderLabel",
      "type": "string",
      "enum": [
        "Met",
        "Tried",
        "Gets it",
        "Can explain",
        "Remembers",
        "Can use it"
      ]
    },
    "WeakSpotCause": {
      "title": "WeakSpotCause",
      "type": "string",
      "enum": [
        "missing-foundation",
        "misconception",
        "gap",
        "words-without-meaning",
        "language-barrier",
        "forgot",
        "rushed-or-peeked"
      ]
    },
    "NextStep": {
      "title": "NextStep",
      "type": "string",
      "enum": [
        "continue",
        "read-again",
        "try-a-question",
        "explain-it",
        "revise",
        "ask-for-help"
      ],
      "description": "What the dashboard suggests doing next for a section."
    },
    "EventRead": {
      "title": "EventRead",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "profileId",
        "kind",
        "actor",
        "actorId",
        "at",
        "detail"
      ],
      "properties": {
        "eventId": {
          "$ref": "common.schema.json#/definitions/DashboardId",
          "description": "Client-made UUID, or mig-{subjectId}-{knowledgeId}-{sectionId} for imported reading events. Idempotency key within a profile."
        },
        "profileId": {
          "$ref": "common.schema.json#/definitions/DashboardId",
          "description": "The student's subject id. Must equal the token's profile, otherwise EVENT_INVALID."
        },
        "knowledgeId": {
          "$ref": "common.schema.json#/definitions/DashboardId"
        },
        "contentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "sectionId": {
          "$ref": "common.schema.json#/definitions/DashboardId"
        },
        "blockId": {
          "$ref": "common.schema.json#/definitions/DashboardId"
        },
        "kind": {
          "const": "read"
        },
        "language": {
          "$ref": "common.schema.json#/definitions/DashboardLanguage"
        },
        "style": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "actor": {
          "type": "string",
          "enum": [
            "student",
            "parent"
          ]
        },
        "actorId": {
          "$ref": "common.schema.json#/definitions/DashboardId"
        },
        "at": {
          "$ref": "common.schema.json#/definitions/DashboardTime"
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "imported": {
              "type": "boolean"
            },
            "seconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "description": "A `read` event."
    },
    "EventListen": {
