              "type": "string",
              "enum": [
                "mcq",
                "text",
                "match",
                "order",
                "true-false"
              ]
            },
            "response": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "maxItems": 50
                }
              ]
            },
            "correct": {
              "type": "boolean"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
