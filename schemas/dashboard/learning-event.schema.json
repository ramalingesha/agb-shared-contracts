        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fromSeconds",
            "toSeconds"
          ],
          "properties": {
            "fromSeconds": {
              "type": "number",
              "minimum": 0
            },
            "toSeconds": {
              "type": "number",
              "minimum": 0
            },
            "speed": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      },
      "description": "A `listen` event."
    },
