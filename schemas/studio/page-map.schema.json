{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudioPageMap",
  "description": "studio-jobs/<job>/page-map.json: for each block id, the book pages it came from (from the source inventory page ranges).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job",
    "blocks"
  ],
  "properties": {
    "job": {
      "$ref": "common.schema.json#/definitions/StudioId"
    },
    "source": {
      "type": "string",
      "description": "Store key of the source file the pages refer to."
    },
    "blocks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
