{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudioCommon",
  "description": "Shared building blocks of the Content Studio contracts (AGB-889). No OS, path style or machine is assumed anywhere: paths are store keys, always relative and forward-slash.",
  "definitions": {
    "StoreKey": {
      "title": "StoreKey",
      "type": "string",
      "maxLength": 240,
      "pattern": "^(?!\\.{1,2}(/|$))(?!.*/\\.{1,2}(/|$))[A-Za-z0-9._@-]+(/[A-Za-z0-9._@-]+)*$",
      "description": "A relative, forward-slash key such as jobs/<id>/inventory.json. No leading slash, no drive letter, no backslash, no '.' or '..' segment."
    },
    "StudioId": {
      "title": "StudioId",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 80
    },
    "StageId": {
      "title": "StageId",
      "type": "string",
      "enum": [
        "inventory",
        "master",
        "generate",
        "slides",
        "narration-script",
        "audio",
        "translation",
        "publish"
      ]
    },
    "StageStatus": {
      "title": "StageStatus",
      "type": "string",
      "enum": [
        "queued",
        "leased",
        "running",
        "failed",
        "succeeded"
      ]
    },
    "Tier": {
      "title": "Tier",
      "type": "string",
      "enum": [
        "Free",
        "Standard",
        "Premium",
        "Enterprise"
      ]
    },
    "LanguageTag": {
      "title": "LanguageTag",
      "type": "string",
      "pattern": "^[a-z]{2,3}$"
    },
    "Timestamp": {
      "title": "Timestamp",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "TemplateKind": {
      "title": "TemplateKind",
      "type": "string",
      "enum": [
        "lesson",
        "narration-style",
        "slide",
        "voice-emotion",
        "picture-kit",
        "audience"
      ]
    },
    "TemplateRef": {
      "title": "TemplateRef",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/StudioId"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "standard",
            "circle",
            "mine"
          ],
          "description": "Where the template comes from (2.13.0). Custom ones are pinned per job. Absent means standard."
        }
      }
    },
    "ProducerKind": {
      "title": "ProducerKind",
      "type": "string",
      "pattern": "^(manual|claude-session|rules|fake|(api|voice|parse):[a-z0-9][a-z0-9-]*)$",
      "description": "manual, claude-session, rules, fake (tests), or api:<provider>, voice:<provider>, parse:<provider>. A provider is a name, not an enum entry, so adding one never changes a schema."
    },
    "ReviewState": {
      "title": "ReviewState",
      "type": "string",
      "enum": [
        "draft",
        "in-review",
        "changes-requested",
        "approved",
        "locked"
      ]
    },
    "Provenance": {
      "title": "Provenance",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "version",
        "machine",
        "person",
        "at"
      ],
      "properties": {
        "producer": {
          "$ref": "#/definitions/ProducerKind"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        },
        "person": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "$ref": "#/definitions/Timestamp"
        }
      }
    },
    "NarrationStyle": {
      "title": "NarrationStyle",
      "type": "string",
      "enum": [
        "simple",
        "favorite-teacher",
        "professional",
        "friend"
      ]
    },
    "FacetKey": {
      "title": "FacetKey",
      "type": "string",
      "pattern": "^(narration|audio):(simple|favorite-teacher|professional|friend):[a-z]{2,3}$|^(slides|buddy):[a-z]{2,3}$",
      "description": "narration:<style>:<lang>, audio:<style>:<lang>, slides:<lang>, buddy:<lang> (2.13.0)."
    }
  }
}
