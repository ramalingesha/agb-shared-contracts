{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudioPractice",
  "description": "studio-jobs/<job>/items/practice/out/practice.json: ids only. The question and its answer live once, in the lesson block; this file holds no question text and no answer text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job",
    "questions"
  ],
  "properties": {
    "job": {
      "$ref": "common.schema.json#/definitions/StudioId"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "questionId",
          "order",
          "kind",
          "readAgain",
          "linkSource"
        ],
        "properties": {
          "questionId": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "mcq",
              "true-false",
              "odd-one-out",
              "short",
              "long",
              "fill-blank",
              "activity",
              "personal"
            ]
          },
          "ref": {
            "type": "string",
            "description": "The book's question number, when it is a book question."
          },
          "readAgain": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Section ids that answer the question."
          },
          "linkSource": {
            "type": "string",
            "enum": [
              "master",
              "own-section",
              "session"
            ]
          }
        }
      }
    }
  }
}
