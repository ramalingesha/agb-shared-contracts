{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudioInventory",
  "description": "studio-jobs/<job>/inventory.json: the source inventory parsed from inventory.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job",
    "pages",
    "items"
  ],
  "properties": {
    "job": {
      "$ref": "common.schema.json#/definitions/StudioId"
    },
    "source": {
      "type": "string",
      "description": "Store key of the source file."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "text",
          "section",
          "pages"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[TDFEQABP]-[0-9]{2,}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "T",
              "D",
              "F",
              "E",
              "Q",
              "A",
              "B",
              "P"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*[lr]?$",
              "description": "A scan page number with an optional l or r side for a two-page spread, such as 12 or 12l."
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "rebuild",
              "as-is"
            ],
            "default": "rebuild"
          },
          "seePage": {
            "type": "boolean"
          },
          "unreadable": {
            "type": "boolean"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "description": "The page ledger: every scan page is accounted for.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "status",
          "questions"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "printed": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "covered",
              "skipped"
            ]
          },
          "questions": {
            "type": "integer",
            "minimum": 0
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
