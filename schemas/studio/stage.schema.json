{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudioStage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job",
    "stage",
    "status",
    "attempt"
  ],
  "properties": {
    "job": {
      "$ref": "common.schema.json#/definitions/StudioId"
    },
    "stage": {
      "$ref": "common.schema.json#/definitions/StageId"
    },
    "status": {
      "$ref": "common.schema.json#/definitions/StageStatus"
    },
    "producer": {
      "$ref": "common.schema.json#/definitions/ProducerKind"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "item": {
      "type": "string",
      "description": "For the generate stage: one stage item per output type, e.g. lesson, study-jam, buddy-bank."
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/definitions/StoreKey"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/definitions/StoreKey"
      }
    },
    "error": {
      "type": "string"
    },
    "provenance": {
      "$ref": "common.schema.json#/definitions/Provenance"
    },
    "checks": {
      "type": "array",
      "description": "Failed checks in plain words, set when a stage fails its checks.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "previousCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "description": "The branch commit before this stage regenerated its output (before/after view)."
    },
    "retryAfter": {
      "$ref": "common.schema.json#/definitions/Timestamp",
      "description": "Set when the person's Claude usage limit paused this item (2.11.0)."
    },
    "scope": {
      "type": "string",
      "description": "For a generate re-run: the block key (or keys) to change; everything else is locked (2.11.0)."
    },
    "targetItem": {
      "type": "string",
      "description": "For a generate re-run: the item the block key belongs to (2.11.0)."
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step"
      ],
      "description": "What the Runner is doing now (2.12.0). The step is a closed list so every language can translate it; message is never shown as free text to other people.",
      "properties": {
        "step": {
          "type": "string",
          "enum": [
            "fetching-source",
            "rendering-pages",
            "ocr",
            "reading-batch",
            "master-group",
            "generating-item",
            "checks",
            "pushing-checkpoint"
          ]
        },
        "i": {
          "type": "integer",
          "minimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "wait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "description": "Why a queued stage is not running yet, computed by the Worker (2.12.0). First matching reason wins.",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "start",
            "review",
            "dependency",
            "usage",
            "runner",
            "busy",
            "capacity",
            "claim",
            "paused",
            "cancelled"
          ]
        },
        "since": {
          "$ref": "common.schema.json#/definitions/Timestamp"
        },
        "retryAfter": {
          "$ref": "common.schema.json#/definitions/Timestamp"
        },
        "detail": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "startedAt": {
      "$ref": "common.schema.json#/definitions/Timestamp"
    },
    "finishedAt": {
      "$ref": "common.schema.json#/definitions/Timestamp"
    },
    "estimate": {
      "$ref": "job-plan.schema.json#/definitions/StageEstimate"
    },
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "description": "Measured after the stage ended (2.12.0).",
      "properties": {
        "activeMs": {
          "type": "integer",
          "minimum": 0
        },
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "tokensIn": {
          "type": "integer",
          "minimum": 0
        },
        "tokensOut": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "generate"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "required": [
          "item"
        ]
      }
    }
  ]
}
