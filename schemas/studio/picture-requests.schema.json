{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudioPictureRequests",
  "description": "studio-jobs/<job>/picture-requests.json: pictures to draw in our own kit. A scan page is only a place to look, never a copy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job",
    "requests"
  ],
  "properties": {
    "job": {
      "$ref": "common.schema.json#/definitions/StudioId"
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "alt",
          "describe"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "describe": {
            "type": "string",
            "minLength": 1
          },
          "kitParts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "page": {
            "type": "string",
            "pattern": "^[1-9][0-9]*[lr]?$"
          },
          "block": {
            "type": "string"
          }
        }
      }
    }
  }
}
