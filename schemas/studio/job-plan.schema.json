{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudioJobPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job",
    "stages",
    "basis"
  ],
  "definitions": {
    "StageEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "sessions",
        "minutes",
        "tokens",
        "confidence"
      ],
      "description": "Plan and estimate for one Claude-session stage (2.12.0). Sessions and tokens of the person's own Claude plan; no money.",
      "properties": {
        "stage": {
          "$ref": "common.schema.json#/definitions/StageId"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "batches": {
          "type": "integer",
          "minimum": 0
        },
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "minutes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "low",
            "high"
          ],
          "properties": {
            "low": {
              "type": "number",
              "minimum": 0
            },
            "high": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "low",
            "high"
          ],
          "properties": {
            "low": {
              "type": "number",
              "minimum": 0
            },
            "high": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "exact",
            "typical",
            "rough",
            "calibrated"
          ]
        },
        "canStart": {
          "type": "boolean"
        },
        "blockedBy": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  },
  "properties": {
    "job": {
      "$ref": "common.schema.json#/definitions/StudioId"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/StageEstimate"
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template"
      ],
      "properties": {
        "template": {
          "type": "string"
        },
        "ratesVersion": {
          "type": "string"
        },
        "calibratedFrom": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "personMaxActive": {
          "type": "integer",
          "minimum": 1
        },
        "maxParallelItems": {
          "type": "integer",
          "minimum": 1
        },
        "maxParallelSessions": {
          "type": "integer",
          "minimum": 1
        },
        "loadLimit": {
          "type": "number"
        }
      }
    },
    "autoContinue": {
      "type": "boolean"
    },
    "approved": {
      "type": "array",
      "description": "Stages whose plan the person has started.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "approvedBy",
          "approvedAt"
        ],
        "properties": {
          "stage": {
            "$ref": "common.schema.json#/definitions/StageId"
          },
          "approvedBy": {
            "type": "string"
          },
          "approvedAt": {
            "$ref": "common.schema.json#/definitions/Timestamp"
          }
        }
      }
    }
  }
}
