{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudioJob",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sources",
    "circle",
    "class",
    "subject",
    "book",
    "template",
    "rebuildMode",
    "languages"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/definitions/StudioId"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "$ref": "common.schema.json#/definitions/StoreKey"
          },
          "label": {
            "type": "string"
          },
          "rebuildMode": {
            "type": "string",
            "enum": [
              "rebuild",
              "as-is"
            ]
          },
          "layout": {
            "type": "string",
            "enum": [
              "auto",
              "single",
              "spread"
            ],
            "default": "auto",
            "description": "Scan layout: auto detects two-page spreads, single is one book page per scan page, spread is always two."
          }
        }
      }
    },
    "circle": {
      "$ref": "common.schema.json#/definitions/StudioId"
    },
    "class": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "book": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "$ref": "common.schema.json#/definitions/TemplateRef"
    },
    "rebuildMode": {
      "type": "string",
      "enum": [
        "rebuild",
        "as-is"
      ],
      "default": "rebuild"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/definitions/LanguageTag"
      }
    },
    "notes": {
      "type": "string"
    },
    "state": {
      "$ref": "common.schema.json#/definitions/ReviewState"
    },
    "parentJob": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/StudioId"
        }
      ],
      "description": "Set on an item-level job created by a request-change on one item."
    },
    "item": {
      "type": "string",
      "description": "Block or output id an item-level job is about."
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boardId",
        "classId",
        "subjectId",
        "bookId"
      ],
      "description": "Optional reference into the app catalog; class, subject and book stay human names.",
      "properties": {
        "boardId": {
          "type": "string",
          "minLength": 1
        },
        "classId": {
          "type": "string",
          "minLength": 1
        },
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "bookId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceLanguage": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/LanguageTag"
        }
      ],
      "default": "en",
      "description": "Language of the source book, used for OCR."
    },
    "asIsItems": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]-[0-9]{2,}$"
      },
      "description": "Inventory item ids whose text is kept as in the book. Only effective where the job settings allow as-is."
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started"
      ],
      "description": "Per-job start of generation (2.11.0).",
      "properties": {
        "started": {
          "type": "boolean"
        },
        "startedBy": {
          "type": "string"
        },
        "startedAt": {
          "$ref": "common.schema.json#/definitions/Timestamp"
        },
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/definitions/StudioId"
          },
          "description": "Optional subset of items to run."
        },
        "sample": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sections"
          ],
          "properties": {
            "sections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "description": "Run each item on these sections first (pattern sample)."
        }
      }
    }
  }
}
