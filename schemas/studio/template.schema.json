{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudioTemplate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "kind",
    "body"
  ],
  "description": "A published template version is immutable; a changed pattern becomes a new version.",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/definitions/StudioId"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "$ref": "common.schema.json#/definitions/TemplateKind"
    },
    "description": {
      "type": "string"
    },
    "derivedFrom": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "body": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "lesson"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "required": [
              "sections"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "narration-style"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "required": [
              "rules"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "slide"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "required": [
              "layouts"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "voice-emotion"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "required": [
              "emotions"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "picture-kit"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "required": [
              "kit"
            ]
          }
        }
      }
    }
  ]
}
