{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudioRun",
  "description": "One piece of background work for one item (2.16.0). The run has the estimate, the progress and the result. Review, approval and publish belong to the facet, not the run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "lessonId",
    "jobId",
    "kind",
    "executor",
    "item",
    "state",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^run-[a-z0-9]+$"
    },
    "lessonId": {
      "$ref": "common.schema.json#/definitions/StudioId"
    },
    "jobId": {
      "$ref": "common.schema.json#/definitions/StudioId"
    },
    "kind": {
      "type": "string",
      "enum": [
        "generate",
        "update-sections",
        "edit",
        "voice"
      ],
      "description": "voice is reserved (not built)."
    },
    "executor": {
      "type": "string",
      "enum": [
        "runner",
        "external"
      ],
      "default": "runner"
    },
    "item": {
      "$ref": "common.schema.json#/definitions/StudioId"
    },
    "scope": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "common.schema.json#/definitions/StudioId"
      },
      "description": "Section ids, or null for the whole item."
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample": {
          "type": "boolean"
        },
        "sampleFirst": {
          "type": "boolean"
        }
      }
    },
    "estimate": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "sessions",
        "tokensLow",
        "tokensHigh",
        "minutesLow",
        "minutesHigh"
      ],
      "properties": {
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "tokensLow": {
          "type": "integer",
          "minimum": 0
        },
        "tokensHigh": {
          "type": "integer",
          "minimum": 0
        },
        "minutesLow": {
          "type": "integer",
          "minimum": 0
        },
        "minutesHigh": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "budgetTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "actualTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "paused",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "startedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "$ref": "common.schema.json#/definitions/Timestamp"
    },
    "startedAt": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/definitions/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "finishedAt": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/definitions/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputRef": {
      "type": [
        "object",
        "null"
      ],
      "description": "What the run was made from. Optional keys of known runs (other keys may appear): an import run (executor `external`) has `source: \"import\"`, `from`, `branch`, `path`, `facet`, `language`, `sha256`; a change run has `source: \"change\"`, `facet`, `baseVersion`, `changes` (the comments it carries: `{id, key, kind}`); a voice run (reserved) has `facet` and `version`.",
      "properties": {
        "source": {
          "type": "string",
          "description": "How the run came about when it did not start from a plain Start: `import` or `change` today; other values may come later."
        },
        "from": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "facet": {
          "$ref": "common.schema.json#/definitions/FacetKey"
        },
        "language": {
          "$ref": "common.schema.json#/definitions/LanguageTag"
        },
        "sha256": {
          "$ref": "common.schema.json#/definitions/PreviewHash"
        },
        "baseVersion": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "key",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "edit",
                  "rewrite"
                ]
              }
            }
          }
        }
      }
    },
    "outputRef": {
      "type": [
        "object",
        "null"
      ],
      "description": "What the run produced. An import run has `{facet, sha256, blocks}`; a failed run has `{failure: {code, message, at, checks?}}`; voice is reserved."
    }
  }
}
