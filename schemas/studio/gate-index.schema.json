{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudioGateIndex",
  "description": "studio-jobs/<job>/gate-index.json: the block keys each gate needs approved, grouped by section.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job",
    "gates"
  ],
  "properties": {
    "job": {
      "$ref": "common.schema.json#/definitions/StudioId"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "sections"
        ],
        "properties": {
          "gate": {
            "type": "string",
            "enum": [
              "inventory",
              "master"
            ]
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "keys"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "keys": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
