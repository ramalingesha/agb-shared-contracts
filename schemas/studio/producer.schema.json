{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudioProducer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "input",
    "output"
  ],
  "properties": {
    "kind": {
      "$ref": "common.schema.json#/definitions/ProducerKind"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "stageInstructions",
        "upstreamArtifacts"
      ],
      "properties": {
        "template": {
          "$ref": "common.schema.json#/definitions/TemplateRef"
        },
        "stageInstructions": {
          "$ref": "common.schema.json#/definitions/StoreKey"
        },
        "upstreamArtifacts": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/StoreKey"
          }
        },
        "notes": {
          "type": "string"
        },
        "reviewComments": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/StoreKey"
          }
        },
        "pagesDir": {
          "type": "string",
          "minLength": 1,
          "description": "Optional hint: the local folder of page images a session may read. A working-copy path on the Runner; never committed and never stored in a job."
        },
        "pageImages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^p[0-9]+[lr]?$"
          },
          "description": "Ids of the page images in pagesDir that this run should read."
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "provenance"
      ],
      "properties": {
        "artifact": {
          "$ref": "common.schema.json#/definitions/StoreKey"
        },
        "provenance": {
          "$ref": "common.schema.json#/definitions/Provenance"
        }
      }
    }
  }
}
