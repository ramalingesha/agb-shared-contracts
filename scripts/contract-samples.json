        "type": "qa",
        "kind": "mcq",
        "text": "Which change makes an OnPush TankerCard show the new volume?",
        "options": [
          "this.tank.volume += 500 in the parent",
          "Adding changeDetection: OnPush",
          "Passing a new object to the card",
          "Calling set with the same array"
        ],
        "optionNotes": [
          "Same object: the input reference does not change.",
          "It is already the default.",
          "A new object is a new input reference.",
          "Same array: no notification."
        ],
        "answer": "Passing a new object to the card."
      }
    },
    {
      "definition": "Block",
      "data": {
        "id": "how-it-works-deep1",
        "type": "paragraph",
        "depth": "deep",
        "sectionId": "how-it-works",
        "text": "Under the hood, `markForCheck()` marks the component and its ancestors dirty up to the root, so the next tick visits them."
      }
    },
    {
      "definition": "Block",
      "data": {
        "id": "how-it-works-sum",
        "type": "callout",
        "variant": "summary",
        "sectionId": "how-it-works",
        "text": "In one breath: an OnPush component is checked only when an input reference, its own event, a signal it reads or an async pipe changes."
      }
    },
    {
      "definition": "Block",
      "data": {
        "id": "patterns-p1",
        "type": "callout",
        "variant": "pattern",
        "sectionId": "patterns",
        "text": "Immutable update. Intent: give OnPush a new reference. Use when: changing a list or object held in a signal or input. Smell: mutating in place and calling set with the same object. Avoid when: the data is never shown by an OnPush component."
      }
    },
